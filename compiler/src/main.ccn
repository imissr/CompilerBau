start phase RootPhase {
    info = "Denotes the entry point of your compiler",

    actions {
        pass SPdoScanParse;
        CountOperators;
        CountIdentifiers;
        Demo;
        Optimisations;
        print;
    }
};

traversal Print {
    uid = PRT
};

traversal CountOperators {
    uid = OC,
    nodes = { Program, Binop },
    travdata {
        int add_count,
        int sub_count,
        int mul_count,
        int div_count,
        int mod_count
    }
};

// cocunute needs CIvar,CIvarlet, CIprogram ,CIfini,CIinit ...
traversal CountIdentifiers{
    uid = CI,
    nodes = { Program, Var, VarLet},
    travdata { 
        user htable_stptr ids
    }
};

phase Demo {
    actions {
        traversal RenameIdentifiers {
            uid = RI,
            nodes = { Var, VarLet }
        };

        traversal SumInts {
            uid = SI,
            nodes = { Program, Num },
            travdata {
                int sum
            }
        };
    }
};

phase Optimisations {
    actions {
        traversal OptSubstraction {
            uid = OS,
            nodes = { Binop }
        };

        traversal StrengthReduction {
            uid = SR,
            nodes = { Binop }
        };

        traversal SuperStrengthReduction {
            uid = SSR,
            nodes = { Binop }
        };
    }
};

/*** AST ***/

enum MonOpType {
    prefix = MO,
    values {
        not, neg
    }
};

enum BinOpType {
    prefix = BO,
    values {
        add, sub, mul, div, mod, lt, le, gt, ge, eq, ne,
        and, or
    }
};


nodeset Expr = {Num, Float, Bool, Binop, Var};
nodeset Stmt = {Assign};

// Nodes you want to be able to link to from your symbol table.
nodeset Link = Expr | Stmt;


// Type ⇒ BasicType , BasicType ⇒ bool | int | float
enum BasicType {
    prefix = BT,
    values {
        bool ,int ,float
    }
};


// RetType ⇒ void | BasicType
enum RetType {                   
    prefix = RT,
    values { void, bool, int, float }
};



// programm hold a list of delceration
root node Program {
    children {
        Decls decls { constructor, mandatory }
    }
};

//based on the grammer we have the following type : figuer 1
nodeset Decl = {FunDef, FunDec, GlobalDef, GlobalDec};


node Decls {
    children{
        Decls decl {constructor , mandatory},
        Decls next {constructor} // pointer on the next decl int the list (linked list style).
    }
}; 

// RetType Id ( [Param, ...] )
node FunHeader {
    children {
        Params params { constructor }           // optional for example f() has none
    },

    attributes {
        RetType type  { constructor },            // return type, can be void
        string name { constructor }
    }
};

// [export] FunHeader { FunBody }
// here the compiler needs to know if export exists or doesnt exists :  Two FunDef nodes can differ
node FunDef { 
    children{
        FunHeader header { constructor, mandatory }, 
        FunBody body { constructor, mandatory } // it must have a body 
    },
    attributes{   
        bool export { constructor }
    }
};

// extern RetType Id ( Params ) ;
// extern is not definied Because extern is always there on a declaration, and a value that never changes carries no information.
node FunDec {
    children {
        FunHeader header { constructor, mandatory }
    }
};

// [export] Type Id [ = Expr ] ;
node GlobalDef{
    children{
        Expr init { constructor }
    },
    attributes{
        BasicType type { constructor },
        string name { constructor },
        bool export { constructor }
    }
};

// extern Type Id ;
node GlobalDec{
    attributes{
        BasicType type { constructor },
        string name { constructor }
    }
};

// linked list of paramters
node Params {
    children {
        Param param { constructor, mandatory },
        Params next { constructor }
    }
};

// the parameter node 
node Param {
    attributes {
        BasicType type  { constructor },
        string name { constructor }
    }
};

// linked list of VarDecls
node VarDecls {
    children {
        VarDecl decl  { constructor, mandatory },
        VarDecls next { constructor }
    }
};

// Type Id [ = Expr ] ;
node VarDecl {
    children {
        Expr init { constructor }
    },

    attributes {
        Types type  { constructor },
        string name { constructor }
    }
};


// [VarDec]* [Statement]*
node FunBody {
    children {
        VarDecls decls { constructor },         // can be empty
        Stmts stmts    { constructor }          // can be empty
    }
};


node Stmts {
    children {
        Stmt stmt { constructor, mandatory },
        Stmts next { constructor }
    }
};

node Assign {
    children {
        VarLet let { constructor },
        Expr expr { constructor, mandatory }
    }
};

node Binop {
    children {
        Expr left { constructor, mandatory },
        Expr right { constructor, mandatory }
    },

    attributes {
        BinOpType op { constructor }
    }
};




nodeset Vars {
    nodes = {VarLet, Var},

    attributes {
        string name,
        Link decl
    }
};

node VarLet {
    attributes {
        string name { constructor }  // Repeat from nodeset to add constructor
    }
};

node Var {
    attributes {
        string name { constructor }
    }
};

node Num {
    attributes {
        int val { constructor }
    }
};

node Float {
    attributes {
        float val { constructor }
    }
};

node Bool {
    attributes {
        bool val { constructor }
    }
};
